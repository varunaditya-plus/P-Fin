worker_processes auto;
pid /tmp/p-fin/nginx.pid;
error_log /dev/stderr warn;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    sendfile on;
    client_body_temp_path /tmp/p-fin/client_temp;
    proxy_temp_path /tmp/p-fin/proxy_temp;
    fastcgi_temp_path /tmp/p-fin/fastcgi_temp;
    uwsgi_temp_path /tmp/p-fin/uwsgi_temp;
    scgi_temp_path /tmp/p-fin/scgi_temp;
    resolver ${PFIN_DNS_RESOLVERS} valid=30s;
    resolver_timeout 5s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    map $http_x_forwarded_proto $forwarded_proto {
        default $scheme;
        https https;
        http http;
    }
    # Preserve encoded paths and query strings, including Jellyfin playback tokens.
    map $request_uri $jellyfin_path {
        default /;
        ~^/jellyfin(?<jellyfin_suffix>/.*)$ $jellyfin_suffix;
    }
    map $request_uri $seerr_path {
        default /;
        ~^/seerr(?<seerr_suffix>/.*)$ $seerr_suffix;
    }
    map $http_x_seerr_upstream $seerr_base {
        default "${PFIN_SEERR_URL}";
        "~^https?://(\[[0-9a-fA-F:]+\]|[a-zA-Z0-9_.-]+)(:[0-9]+)?(/[a-zA-Z0-9._~!$&'()*+,;=:@%/-]*)?$" $http_x_seerr_upstream;
    }

    server {
        listen 8080;
        listen [::]:8080;
        server_name _;
        root /usr/share/nginx/html;
        index index.html;
        # Jellyfin image and subtitle uploads use base64 request bodies.
        client_max_body_size 30m;

        location = /health {
            default_type text/plain;
            return 200 'ok\n';
        }
        location = /server-config.json {
            alias /tmp/p-fin/server-config.json;
            default_type application/json;
            add_header Cache-Control "no-store" always;
        }
        location /jellyfin/ {
            set $jellyfin_base "${PFIN_JELLYFIN_URL}";
            if ($jellyfin_base = "") { return 503; }
            # Defer DNS lookup so Jellyfin need not be online during NAS startup.
            proxy_pass $jellyfin_base$jellyfin_path;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_ssl_server_name on;
            proxy_connect_timeout 5s;
            proxy_read_timeout 3600s;
            proxy_buffering off;
            proxy_request_buffering off;
        }
        location /seerr/ {
            if ($seerr_base = "") { return 503; }
            proxy_pass $seerr_base$seerr_path;
            proxy_http_version 1.1;
            proxy_set_header Host $proxy_host;
            proxy_set_header X-Forwarded-Proto $forwarded_proto;
            proxy_set_header X-Seerr-Upstream "";
            proxy_ssl_server_name on;
            proxy_connect_timeout 5s;
            proxy_read_timeout 60s;
            proxy_cookie_domain ~.+ $host;
            proxy_cookie_path ~.* /seerr/;
        }
        location /assets/ {
            try_files $uri =404;
            add_header Cache-Control "public, max-age=31536000, immutable";
        }
        location = /index.html {
            add_header Cache-Control "no-cache";
        }
        location = /sw.js {
            add_header Cache-Control "no-cache";
        }
        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
