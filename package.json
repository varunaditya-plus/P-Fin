{
  "packageManager": "pnpm@9.14.4",
  "name": "P-Stream",
  "version": "5.3.7",
  "private": true,
  "homepage": "https://github.com/p-stream/p-stream",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:pwa": "cross-env VITE_PWA_ENABLED=true vite build",
    "test": "vitest run",
    "preview": "vite preview",
